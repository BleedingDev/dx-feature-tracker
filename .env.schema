# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
#
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Example non-secret setting. Replace with the project's real variables.
# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Set by portless when `pnpm dev` runs the web app (http://rat-stack.localhost:1355).
# The web dev composition passes it to Better Auth as baseURL.
# @type=url
# @sensitive=false
PORTLESS_URL=

# dft data folder (store, spools, hook observations). Defaults to ~/.dft.
# @type=string
# @sensitive=false
DFT_HOME=

# Set to "off" to disable the Cursor usage API poller (tests always set it).
# @type=string
# @sensitive=false
DFT_CURSOR_USAGE=

# Comma-separated harness ids for the opt-in live conformance tier, for
# example "claude-code,codex". Unset means the live tier is skipped.
# @type=string
# @sensitive=false
DFT_LIVE_HARNESSES=

# Home folder; every harness location is resolved under it unless overridden.
# @type=string
# @sensitive=false
HOME=

# Claude Code config folder override (default ~/.claude).
# @type=string
# @sensitive=false
CLAUDE_CONFIG_DIR=

# Codex home override (default ~/.codex).
# @type=string
# @sensitive=false
CODEX_HOME=

# Agent folder override shared by Pi (default ~/.pi/agent) and OMP (default
# ~/.omp/agent), as both tools read it.
# @type=string
# @sensitive=false
PI_CODING_AGENT_DIR=

# OMP config folder name under HOME (default .omp); sessions live under
# <folder>/agent and stats.db at <folder>.
# @type=string
# @sensitive=false
PI_CONFIG_DIR=

# OMP profile name; moves OMP to <config folder>/profiles/<name>.
# @type=string
# @sensitive=false
PI_PROFILE=

# DeepSeek Harness home override (default ~/.dsh).
# @type=string
# @sensitive=false
DSH_HOME=

# XDG data and config homes, used for OpenCode (default ~/.local/share, ~/.config).
# @type=string
# @sensitive=false
XDG_DATA_HOME=

# @type=string
# @sensitive=false
XDG_CONFIG_HOME=
